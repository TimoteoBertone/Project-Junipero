# Supabase (Auth + data)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth (create in Google Cloud Console → OAuth client IDs)
# Enable Google provider in Supabase Auth and paste the Web client ID/secret there too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Apple Sign In
# Enable Apple provider in Supabase Auth (Services ID + key/secret from Apple Developer).
# Native iOS uses bundle id com.projectjunipero.app + usesAppleSignIn.
EXPO_PUBLIC_APPLE_SERVICE_ID=com.projectjunipero.app.signin
EXPO_PUBLIC_APPLE_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/auth/v1/callback
